<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Leave.aspx.cs" Inherits="Leave" %>  <!DOCTYPE html> <html> <head runat="server">     <title>Leave Management</title>     <style>         body { font-family: Arial, sans-serif; background-color: #f9f9f9; margin: 30px; }         .container { width: 800px; margin: 0 auto; background: #ffffff; padding: 20px; border: 1px solid #ddd; }         .header { display: flex; justify-content: space-between; border-bottom: 2px solid #0066cc; padding-bottom: 10px; }         .nav { margin: 15px 0; padding: 10px; background-color: #eef2f7; } 
       .nav a, .nav asp\:LinkButton { margin-right: 15px; font-weight: bold; text-decoration: none; color: #0066cc; }         .form-row { margin-bottom: 15px; }         label { font-weight: bold; display: inline-block; width: 140px; }         .cal-container { display: flex; gap: 40px; margin: 15px 0; }         .cal-box { border: 1px solid #ccc; padding: 10px; background-color: #fafafa; }         .btn { background-color: #0066cc; color: white; padding: 8px 16px; border: none; cursor: pointer; font-size: 14px; }         .result-box { margin-top: 25px; padding: 15px; background-color: #e6ffec; border: 1px solid #70db70; border-radius: 4px; }         .result-box h4 { margin-top: 0; color: #006600; }     </style> </head> <body>     <form id="form1" runat="server">         <div class="container">             <!-- Header Section -->             <div class="header">                 <h2>Leave Management System</h2>                 <p>Logged in as: <b><asp:Label ID="lblUser" runat="server" ForeColor="#0066cc"></asp:Label></b></p>             </div>              <!-- Navigation Bar -->             <div class="nav">                 <a href="Default.aspx">📅 Academic Calendar</a> |                  <a href="Leave.aspx">📝 Apply Leave</a> |                  <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" ForeColor="Red">Logout</asp:LinkButton>             </div> 
 <h3>Student Leave Application</h3>              <!-- Student Name -->             <div class="form-row">                 <label>Student Name:</label>                 <asp:TextBox ID="txtStudentName" runat="server" Width="250px"></asp:TextBox>                 <asp:RequiredFieldValidator ID="rfvName" runat="server" ControlToValidate="txtStudentName"                      ErrorMessage="Student Name is required" ForeColor="Red" Display="Dynamic"></asp:RequiredFieldValidator>             </div>              <!-- Leave Type (DropDownList) -->             <div class="form-row">                 <label>Leave Type:</label>                 <asp:DropDownList ID="ddlLeaveType" runat="server" Width="258px">                     <asp:ListItem Text="Sick Leave" Value="Sick Leave"></asp:ListItem>                     <asp:ListItem Text="Casual Leave" Value="Casual Leave"></asp:ListItem>                     <asp:ListItem Text="Emergency Leave" Value="Emergency Leave"></asp:ListItem>                 </asp:DropDownList>             </div>              <!-- Rich Controls: Calendars for From Date and To Date -->             <div class="cal-container">                 <div class="cal-box">                     <b>From Date (Calendar Control):</b><br />                     <asp:Calendar ID="calFrom" runat="server" BackColor="White" BorderColor="#999999"                          CellPadding="2" Font-Names="Verdana" Font-Size="8pt" ForeColor="Black"                          Height="160px" Width="220px" OnSelectionChanged="calFrom_SelectionChanged">                         <SelectedDayStyle BackColor="#0066cc" ForeColor="White" />            ANUBHAV J GORAGUDDI (92400120380)     BATCH: B     |50                             <TitleStyle BackColor="#336699" Font-Bold="True" ForeColor="White" />                     </asp:Calendar>                     Selected: <b><asp:Label ID="lblFromDate" runat="server" ForeColor="#0066cc">Not Selected</asp:Label></b>                 </div>                  <div class="cal-box">                     <b>To Date (Calendar Control):</b><br />                     <asp:Calendar ID="calTo" runat="server" BackColor="White" BorderColor="#999999"                          CellPadding="2" Font-Names="Verdana" Font-Size="8pt" ForeColor="Black"                          Height="160px" Width="220px" OnSelectionChanged="calTo_SelectionChanged">                         <SelectedDayStyle BackColor="#0066cc" ForeColor="White" />                         <TitleStyle BackColor="#336699" Font-Bold="True" ForeColor="White" />                     </asp:Calendar>                     Selected: <b><asp:Label ID="lblToDate" runat="server" ForeColor="#0066cc">Not Selected</asp:Label></b>                 </div>             </div>              <!-- Reason -->             <div class="form-row">                 <label>Reason for Leave:</label>                 <asp:TextBox ID="txtReason" runat="server" TextMode="MultiLine" Rows="3" Width="350px"></asp:TextBox>                 <asp:RequiredFieldValidator ID="rfvReason" runat="server" ControlToValidate="txtReason"                      ErrorMessage="Reason is required" ForeColor="Red" Display="Dynamic"></asp:RequiredFieldValidator>             </div>              <!-- Submit Button -->             <div class="form-row">
 <asp:Button ID="btnApply" runat="server" Text="Apply Leave" CssClass="btn" OnClick="btnApply_Click" />             </div>              <!-- Status / Error Message -->             <asp:Label ID="lblMessage" runat="server"></asp:Label>              <!-- Result Panel displaying details saved in Session -->             <asp:Panel ID="pnlResult" runat="server" Visible="false" CssClass="result-box">                 <h4>Leave Application Submitted Successfully (Retrieved from Session):</h4>                 <p><b>Student Name:</b> <asp:Label ID="lblDispName" runat="server"></asp:Label></p>                 <p><b>Leave Type:</b> <asp:Label ID="lblDispType" runat="server"></asp:Label></p>                 <p><b>From Date:</b> <asp:Label ID="lblDispFrom" runat="server"></asp:Label></p>                 <p><b>To Date:</b> <asp:Label ID="lblDispTo" runat="server"></asp:Label></p>                 <p><b>Reason:</b> <asp:Label ID="lblDispReason" runat="server"></asp:Label></p>                 <p><b>Application Status:</b> <span style="color: green; font-weight: bold;">Submitted (Pending Approval)</span></p>             </asp:Panel>         </div>     </form> </body> </html> 
