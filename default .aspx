<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Default.aspx.cs" Inherits="_Default" %>  <!DOCTYPE html> <html> <head runat="server">     <title>Academic Calendar</title>     <style>         body { font-family: Arial, sans-serif; background-color: #f9f9f9; margin: 30px; }         .container { width: 800px; margin: 0 auto; background: #ffffff; padding: 20px; border: 1px solid #ddd; }         .header { display: flex; justify-content: space-between; border-bottom: 2px solid #0066cc; padding-bottom: 10px; }         .nav { margin: 15px 0; padding: 10px; background-color: #eef2f7; }         .nav a, .nav asp\:LinkButton { margin-right: 15px; font-weight: bold; text-decoration: none; color: #0066cc; }         .calendar-section { display: flex; gap: 30px; margin-top: 20px; } 
 .event-box { flex: 1; padding: 15px; background-color: #fbfbfb; border: 1px solid #e0e0e0; }         .btn { background-color: #0066cc; color: white; padding: 6px 12px; border: none; cursor: pointer; }         .grid-style { width: 100%; border-collapse: collapse; margin-top: 10px; }         .grid-style th { background-color: #0066cc; color: white; padding: 8px; text-align: left; }         .grid-style td { padding: 8px; border-bottom: 1px solid #ddd; }     </style> </head> <body>     <form id="form1" runat="server">         <div class="container">             <!-- Header Section -->             <div class="header">                 <h2>Academic Calendar & Leave Management</h2>                 <p>Logged in as: <b><asp:Label ID="lblUser" runat="server" ForeColor="#0066cc"></asp:Label></b></p>             </div>              <!-- Navigation Bar -->             <div class="nav">                 <a href="Default.aspx">📅 Academic Calendar</a> |                  <a href="Leave.aspx">📝 Apply Leave</a> |                  <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" ForeColor="Red">Logout</asp:LinkButton>             </div>              <h3>Academic Calendar (Rich Control Demo)</h3>             <p>Select any date from the Calendar control below to view or schedule an academic event.</p> 
  <div class="calendar-section">                 <!-- Rich Control: ASP.NET Calendar -->                 <div>                     <asp:Calendar ID="Calendar1" runat="server"                          BackColor="White" BorderColor="#999999" CellPadding="4"                          DayNameFormat="Shortest" Font-Names="Verdana" Font-Size="9pt"                          ForeColor="Black" Height="220px" Width="280px"                          OnSelectionChanged="Calendar1_SelectionChanged">                         <SelectedDayStyle BackColor="#0066cc" Font-Bold="True" ForeColor="White" />                         <TodayDayStyle BackColor="#CCCCCC" ForeColor="Black" />                         <TitleStyle BackColor="#336699" BorderColor="Black" Font-Bold="True" ForeColor="White" />                     </asp:Calendar>                 </div>                  <!-- Event Details & Add Event Box -->                 <div class="event-box">                     <h4>Add / View Academic Event</h4>                     <p>Selected Date: <b><asp:Label ID="lblSelectedDate" runat="server" ForeColor="#0066cc">None</asp:Label></b></p>                                          <label>Event Name:</label><br />                     <asp:TextBox ID="txtEventName" runat="server" Width="90%"></asp:TextBox>                     <br /><br />                     <asp:Button ID="btnAddEvent" runat="server" Text="Add Event" CssClass="btn" OnClick="btnAddEvent_Click" />                     <br /><br />                     <asp:Label ID="lblEventMsg" runat="server"></asp:Label>                 </div>             </div> 
  <hr style="margin-top: 25px;" />              <!-- Academic Events Table / GridView -->             <h3>Scheduled Academic Events</h3>             <asp:GridView ID="gvEvents" runat="server" CssClass="grid-style" AutoGenerateColumns="true">             </asp:GridView>         </div>     </form> </body> </html> 
